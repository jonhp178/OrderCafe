@model IEnumerable<OrderCafe.Models.Customer>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_MasterAdmin.cshtml";
}

<div class="account-page-heading">
    <div>
        <p class="account-eyebrow">QUẢN TRỊ · TÀI KHOẢN</p>
        <h1>Danh sách tài khoản khách</h1>
        <p class="account-description">Quản lý quyền tài khoảng khách.</p>
    </div>

    @Html.ActionLink("Create New", "Create", null, new { @class = "account-add-button" })
</div>
<div class="table-scroll">
    <table class="table admin-table account-table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            @*<th>
                @Html.DisplayNameFor(model => model.PasswordHash)
            </th>*@
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CustomerCode)
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.FullName)
                </td>
                <td>
                    @(string.IsNullOrWhiteSpace(item.Email) ? "—" : item.Email)
                </td>
                @*<td>
                    @Html.DisplayFor(modelItem => item.PasswordHash)
                </td>*@
                <td>
                    @Html.DisplayFor(modelItem => item.Phone)
                </td>
                <td>
                    <span class="account-status @(item.IsActive ? "status-active" : "status-locked")">
                        @(item.IsActive ? "Đang hoạt động" : "Đã khóa")
                    </span>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedAt)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CustomerCode)
                </td>
                <td>
                    <!-- Nhóm các nút thao tác để chúng nằm cạnh nhau -->
                    <div class="action-buttons">
                        @Html.ActionLink("Edit", "Edit", new { id = item.UserId }, new { @class = "account-action action-edit" })
                        @Html.ActionLink("Details", "Details", new { id = item.UserId }, new { @class = "account-action action-details" })
                        @Html.ActionLink("Delete", "Delete", new { id = item.UserId }, new { @class = "account-action action-delete" })
                    </div>
                </td>
            </tr>
        }
    </table>
</div>

    
