<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />

    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Areas/Admin/ContentAd/Admin.css"/>
    <link rel="stylesheet" href="~/Areas/Admin/ContentAd/base.css" />
    <link rel="stylesheet" href="~/Areas/Admin/ContentAd/header.css" />
    <link rel="stylesheet" href="~/Areas/Admin/ContentAd/buttons.css" />
    <link rel="stylesheet" href="~/Areas/Admin/ContentAd/menu.css" />
    <link rel="stylesheet" href="~/Areas/Admin/ContentAd/mystyle.css" />
    <!-- Dành cho FA 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    @*<link rel="stylesheet" href="@Url.Content("~/Content/GiaoDien.css")" />*@
    <title>@ViewBag.Title</title>
</head>
<body class="admin-body">
    <header class="admin-header">
        <a class="admin-brand"
           href="@Url.Action("Index", "Home", new { area = "Admin" })">
            <span>HẠT</span>
            <small>COFFEE · ADMIN</small>
        </a>

        <div class="admin-header-right">
            <span class="admin-user">
                Xin chào, @(Session["FullName"] ?? "Quản trị viên")
            </span>

            <a class="store-link" href="@Url.Action("GiaoDien", "Home", new { area = "" })">
                Xem trang cửa hàng
            </a>
        </div>
    </header>

    <div class="admin-shell">
        <aside class="admin-sidebar">
            <p class="sidebar-title">QUẢN TRỊ</p>

            <nav class="sidebar-nav" aria-label="Menu quản trị">
                <a href="@Url.Action("Index", "Home", new { area = "Admin" })">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Tổng quan</span>
                </a>

                <a href="@Url.Action("Index", "Products", new { area = "Admin" })">
                    <i class="fa-solid fa-mug-hot"></i>
                    <span>Sản phẩm</span>
                </a>

                <a href="@Url.Action("Index", "Category", new { area = "Admin" })">
                    <i class="fa-solid fa-layer-group"></i>
                    <span>Thể loại</span>
                </a>

                <a href="@Url.Action("Index", "OrderManage", new { area = "Admin" })">
                    <i class="fa-solid fa-receipt"></i>
                    <span>Đơn hàng</span>
                </a>

                <a href="@Url.Action("Index", "AdminAcc", new { area = "Admin" })">
                    <i class="fa-solid fa-users"></i>
                    <span>Tài khoản admin</span>
                </a>
            </nav>

            <a class="sidebar-store-link"
               href="@Url.Action("GiaoDien", "Home", new { area = "" })">
                ← Về cửa hàng
            </a>

            <a>

            </a>
        </aside>

        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <footer class="admin-footer">
        © @DateTime.Now.Year HẠT COFFEE · Khu vực quản trị
    </footer>
</body>
</html>
