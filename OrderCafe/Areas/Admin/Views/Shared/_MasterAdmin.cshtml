<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Areas/Admin/ContentAd/mystyle.css" />
    <link rel="stylesheet" href="@Url.Content("~/Content/GiaoDien.css")" />
    <title>@ViewBag.Title</title>
</head>
<body>
    <header class="top">
        <div class="wrap bar" >
            <a class="logo" href="@Url.Action("GiaoDien", "Home" )">HẠT<small>COFFEE</small></a>
            <nav aria-label="Điều hướng chính">
                <a href="@Url.Action("Index", "Home")trangchu">Trang chủ</a>
                <a href="@Url.Action("Index", "Product")">Menu</a>
                @*<span aria-disabled="true" title="Menu đang được cập nhật">Menu (đang cập nhật)</span>*@
                <span aria-disabled="true" title="Ưu đãi đang được cập nhật">Ưu đãi (đang cập nhật)</span>
                <a href="@Url.Action("Index", "Home")#thongtin">Thông tin</a>
                @*<a href="@Url.Action("Register", "Account")">Đăn nhập</a>*@
                @if (Session["FullName"] != null)
                {
                    string fullName = (Session["FullName"] as string ?? "").Trim();
                    string shortName = fullName.Split(' ').LastOrDefault();
                    if (string.IsNullOrEmpty(shortName)) { shortName = "Tài khoản"; }

                    <div class="user-dd">
                        <button type="button" class="user-dd-toggle">@shortName &#9662;</button>
                        <div class="user-dd-menu">
                            @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit">Đăng xuất</button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    @Html.ActionLink("Đăng nhập", "Index", "Account")
                    @*@Html.ActionLink("Đăng Ký", "Register", "Account")*@
                }
                <a class="hot" href="tel:123456789">Hotline: 123456789</a>
            </nav>
        </div>
    </header>
    <div id="div-main" style=" display: flex; flex-direction: row;">
        <div id="div-left" style="width: 25%; height: auto; font-size: 20px; font-family: Arial; text-align: center; ">
            <h3 style=" text-align: center;">danh mục sản phẩm</h3>
            <ul style="list-style: none">
                <li>
                    <a href="/Home/Index">trang chủ</a>
                </li>
                <li>
                    <a href="/Home/TrangChu">Máy tính để bàn</a>
                </li>
                <li>
                    điện thoại
                </li>
                <li>
                    phụ kiện
                </li>
                <li>
                    <a href="/Categories/Index">Thể loại</a>
                </li>
                <li>
                    <a href="/Home/ThongTin">thông tin</a>
                </li>
                <li>
                    <a href="/Home/DangKy">đăng ký</a>
                </li>
            </ul>
        </div>
        <div id="div-right" style="width: 75%; background-color: antiquewhite;">
            @RenderBody()
        </div>
    </div>
    <div>
        <footer>
            <p>&copy; @DateTime.Now.Year - HẠT COFFEE</p>
        </footer>
    </div>
</body>
</html>
