@model OrderCafe.Models.Product

<div class="col-md-4">
    <div class="thumbnail">
        <img src="@Url.Content("~/content/Images" + Model.ImageUrl)" alt="@Model.ProductName" style="height:180px; object-fit:cover;" />
        <div class="caption">
            <h4>@Model.ProductName</h4>
            <p>Thể loại: @Model.Category.CategoryName</p>
            <p><strong>@Model.Price.ToString("#,##0") đ</strong></p>
            @Html.ActionLink("mua", "Details", "Sach", new { id = Model.ProductName },
                new { @class = "btn btn-primary" })
        </div>
    </div>
</div>
