@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = null;
}

@model OrderCafe.Models.Customer

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký tài khoản - Hạt Coffee</title>
    <!-- Nhúng thư viện Bootstrap 5 qua CDN để làm đẹp toàn bộ form -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <!-- Khung Card chứa form đăng ký -->
                <div class="card shadow p-4 border-0 rounded-4">
                    <h3 class="text-center mb-4 text-success fw-bold">Đăng Ký Tài Khoản</h3>
                    <hr class="mb-4" />

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                        <div class="mb-3">
                            @Html.LabelFor(model => model.FullName, "Họ và tên", htmlAttributes: new { @class = "form-label fw-semibold" })
                            @Html.EditorFor(model => model.FullName, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập họ và tên..." } })
                            @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Email, "Email", htmlAttributes: new { @class = "form-label fw-semibold" })
                            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập địa chỉ email..." } })
                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger small" })
                            @if (ViewBag.error != null)
                            {
                                <div class="text-danger small mt-1">@ViewBag.error</div>
                            }
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.PasswordHash, "Mật khẩu", htmlAttributes: new { @class = "form-label fw-semibold" })
                            @Html.PasswordFor(model => model.PasswordHash, new { @class = "form-control", placeholder = "Nhập mật khẩu..." })
                            @Html.ValidationMessageFor(model => model.PasswordHash, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Phone, "Số điện thoại", htmlAttributes: new { @class = "form-label fw-semibold" })
                            @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập số điện thoại..." } })
                            @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.IsActive, "tích chọn", htmlAttributes: new { @class = "form-label fw-semibold" })
                            @Html.CheckBoxFor(model => model.IsActive, new { htmlAttributes = new { @class = "form-control", placeholder = "voi lòng tích chọn" } })
                            @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger small" })
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <input type="submit" value="Đăng ký ngay" class="btn btn-success btn-lg fw-bold" />
                        </div>
                    }

                    <div class="text-center mt-3">
                        @Html.ActionLink("Đã có tài khoản? Đăng nhập", "Login", "Account", null, new { @class = "text-decoration-none text-secondary small" })
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
