@{
    ViewBag.Title = "Thông tin về quán";
    Layout = "~/Views/Shared/_GiaoDien.cshtml";
}


<main class="cafe-about" id="thongtin">
    <section class="about-intro" aria-labelledby="about-title">
        <div>
            <p class="about-kicker">HẠT COFFEE / CÂU CHUYỆN CỦA QUÁN</p>
            <h1 id="about-title">Một chút chậm lại.<br />Một tách cà phê ngon.</h1>
            <p class="about-lead">Một góc nhỏ để làm việc, trò chuyện và dành thời gian cho chính mình. Hạt Coffee mong mỗi lần ghé quán đều là một khoảng nghỉ dễ chịu trong ngày.</p>
            <div class="about-actions">
                <a class="about-button" href="@Url.Action("Index", "Product", new { area = "" })">Khám phá menu</a>
                <a class="about-text-link" href="#nguyen-lieu">Tìm hiểu nguyên liệu &darr;</a>
            </div>
        </div>
        <figure class="about-photo">
            <img src="@Url.Content("~/Content/Images/cape(1).jpg")" alt="Ly cà phê sữa đá bên những hạt cà phê" />
            <figcaption>Hương vị quen thuộc, niềm vui mỗi ngày.</figcaption>
        </figure>
    </section>

    <div class="about-shortcuts" aria-label="Các phần trong trang thông tin">
        <a href="#ve-quan">01 / Về quán</a>
        <a href="#nguyen-lieu">02 / Nguyên liệu</a>
        <a href="#chu-truong">03 / Chủ trương</a>
        <a href="#ghe-quan">04 / Ghé Hạt</a>
    </div>

    @* Nội dung giới thiệu mẫu; chỉnh lại nguyên liệu và chủ trương theo thực tế của quán. *@
    <section class="about-section about-story" id="ve-quan" aria-labelledby="story-title">
        <div>
            <p class="about-kicker">01 / VỀ QUÁN</p>
            <h2 id="story-title">Một nơi để bạn thấy thân quen.</h2>
        </div>
        <div>
            <p>Hạt Coffee là quán cà phê tại Quận 10, TP. Hồ Chí Minh. Quán hướng đến một không gian gần gũi, nơi bạn có thể bắt đầu buổi sáng, tập trung làm việc hoặc gặp gỡ những người mình yêu quý.</p>
            <p>Với Hạt, trải nghiệm thưởng thức bắt đầu từ những điều nhỏ: một thức uống hợp khẩu vị, cách phục vụ chu đáo và một chỗ ngồi khiến bạn muốn nán lại lâu hơn.</p>
        </div>
    </section>

    <section class="about-section" id="nguyen-lieu" aria-labelledby="ingredients-title">
        <p class="about-kicker">02 / NGUYÊN LIỆU</p>
        <h2 id="ingredients-title">Chăm chút từ những thành phần đầu tiên.</h2>
        <p class="about-section-intro">Định hướng của Hạt là lựa chọn nguyên liệu phù hợp với từng món, chú ý cách bảo quản và giữ hương vị hài hòa khi pha chế.</p>
        <div class="about-cards">
            <article class="about-card">
                <span class="about-card-number" aria-hidden="true">01</span>
                <h3>Cà phê</h3>
                <p>Ưu tiên hạt có nguồn gốc rõ ràng, lựa chọn mức rang và công thức phù hợp để giữ hương thơm cùng vị cà phê đặc trưng.</p>
            </article>
            <article class="about-card">
                <span class="about-card-number" aria-hidden="true">02</span>
                <h3>Trà &amp; trái cây</h3>
                <p>Chú trọng hương vị tự nhiên, sự cân bằng giữa vị trà và trái cây; kiểm tra tình trạng nguyên liệu trước khi sử dụng.</p>
            </article>
            <article class="about-card">
                <span class="about-card-number" aria-hidden="true">03</span>
                <h3>Sữa &amp; thành phần pha chế</h3>
                <p>Lựa chọn thành phần phù hợp với công thức, theo dõi hạn sử dụng và bảo quản theo hướng dẫn của nhà sản xuất.</p>
            </article>
        </div>
        <p class="about-note">Bạn cần biết thành phần của một món hoặc có dị ứng thực phẩm? Hãy trao đổi với nhân viên trước khi đặt để được tư vấn món phù hợp.</p>
    </section>

    <section class="about-section about-values" id="chu-truong" aria-labelledby="values-title">
        <p class="about-kicker">03 / CHỦ TRƯƠNG CỦA HẠT</p>
        <h2 id="values-title">Tử tế trong từng việc nhỏ.</h2>
        <div class="about-cards">
            <article>
                <h3>Chất lượng nhất quán</h3>
                <p>Chú trọng công thức, vệ sinh dụng cụ và thao tác pha chế để mỗi món được phục vụ chỉn chu.</p>
            </article>
            <article>
                <h3>Lắng nghe khách hàng</h3>
                <p>Tư vấn rõ ràng, tiếp nhận góp ý và điều chỉnh trải nghiệm phục vụ từ những phản hồi thực tế.</p>
            </article>
            <article>
                <h3>Sử dụng vừa đủ</h3>
                <p>Hướng đến hạn chế lãng phí nguyên liệu và giảm vật dụng dùng một lần khi điều kiện phục vụ cho phép.</p>
            </article>
        </div>
    </section>

    <section class="about-section about-visit" id="ghe-quan" aria-labelledby="visit-title">
        <div>
            <p class="about-kicker">04 / HẸN BẠN Ở HẠT</p>
            <h2 id="visit-title">Ghé quán, chọn một góc yêu thích.</h2>
            <p>828 Sư Vạn Hạnh, Quận 10, TP. Hồ Chí Minh</p>
            <a class="about-text-link" href="@Url.Action("Index", "Product", new { area = "" })">Chọn món bạn thích &rarr;</a>
        </div>
        <div class="about-hours">
            <h3>Giờ mở cửa</h3>
            <dl>
                <div><dt>Thứ 2 – Thứ 6</dt><dd>07:00 – 22:00</dd></div>
                <div><dt>Thứ 7 – Chủ Nhật</dt><dd>07:00 – 23:00</dd></div>
            </dl>
        </div>
    </section>
</main>
