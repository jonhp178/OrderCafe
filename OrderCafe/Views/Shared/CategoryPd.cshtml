@model IEnumerable<OrderCafe.Models.Category>

<div class="list-group">
    @Html.ActionLink(
        "Tất cả thể loại",
        "Index",
        "Product",
        null,
        new { @class = "list-group-item" })

    @foreach (var item in Model)
    {
        <a class="list-group-item"
           href="@Url.Action("Index", "Product", new { maTL = item.CategoryId })">
            @item.CategoryName
            <span class="badge">@item.Products.Count</span>
        </a>
    }
</div>
