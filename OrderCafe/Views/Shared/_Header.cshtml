@* Thanh điều hướng chính của website *@
<link rel="stylesheet" href="~/Content/GiaoDien.css"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
@*<link rel="stylesheet" href="~/Content/css/base.css" />*@
<header class="top">
    <div class="wrap bar">

        <a class="logo" href="@Url.Action("GiaoDien", "Home")">HẠT<small>COFFEE</small></a>

        <nav aria-label="Điều hướng chính">
            <a href="@Url.Action("GiaoDien", "Home")">Trang chủ</a>
            <a href="@Url.Action("Index", "Product")">Menu</a>
            
            <a href="@Url.Action("Index", "Cart", new { area = "" })" class="text-decoration-none" style="color: black;">
                <i class="fa-solid fa-cart-shopping"></i> Giỏ hàng
            </a>
            @if (string.Equals(Session["role"] as string, "Customer", StringComparison.OrdinalIgnoreCase))
            {
                <a href="@Url.Action("Index", "Order", new { area = "" })">Đơn hàng của tôi</a>
            }
            <span aria-disabled="true" title="Ưu đãi đang được cập nhật">Ưu đãi (đang cập nhật)</span>
            <a href="@Url.Action("ThongTin", "Home", new { area = "" })">Thông tin</a>

            @if (Session["FullName"] != null)
            {
                string fullName = (Session["FullName"] as string ?? "").Trim();
                string shortName = fullName.Split(' ').LastOrDefault();
                if (string.IsNullOrEmpty(shortName)) { shortName = "Tài khoản"; }

                <div class="user-dd">
                    <button type="button" class="user-dd-toggle">
                        <i class="fa-duotone fa-solid fa-user"></i>
                        @shortName &#9662;
                    </button>
                    <div class="user-dd-menu">
                        @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit">Đăng xuất</button>
                        }
                    </div>
                </div>
            }
            else
            {
                <a href="@Url.Action("Index", "Account", new { area = "" })"
                   data-open-login>
                    Đăng nhập
                </a>
            }
            <a class="hot" href="tel:123456789">Hotline: 123456789</a>
        </nav>

    </div>
</header>
