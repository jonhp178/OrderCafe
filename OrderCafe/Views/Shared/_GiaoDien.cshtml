@{
    var controllerName = ViewContext.RouteData.Values["controller"] as string;
    var actionName = ViewContext.RouteData.Values["action"] as string;

    bool autoOpenLogin =
        Session["FullName"] == null &&
        string.Equals(controllerName, "Home", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(actionName, "GiaoDien", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - Hạt Coffee</title>

    <link rel="stylesheet" href="@Url.Content("~/Content/GiaoDien.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/css/login-popup.css")" />
</head>
<body>
    @Html.Partial("_Header")

    <div class="container body-content">
        @RenderBody()
    </div>

    <footer>
        <p>&copy; @DateTime.Now.Year - HẠT COFFEE</p>
    </footer>

    <dialog id="loginPopup"
            aria-labelledby="loginPopupTitle"
            data-auto-open="@(autoOpenLogin ? "true" : "false")">

        <div class="login-heading">
            <button type="button"
                    id="closeLoginPopup"
                    class="login-close"
                    aria-label="Đóng đăng nhập">
                &times;
            </button>
            <h2 id="loginPopupTitle">Đăng nhập tài khoản</h2>
        </div>

        @using (Html.BeginForm(
            "Authen",
            "Account",
            new { area = "" },
            FormMethod.Post,
            new { id = "popupLoginForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="login-field">
                <label for="popupEmail">Email</label>

                <input type="email"
                       id="popupEmail"
                       name="Email"
                       autocomplete="username"
                       placeholder="Nhập email"
                       required />
            </div>

            <div class="login-field">
                <label for="popupPassword">Mật khẩu</label>

                <input type="password"
                       id="popupPassword"
                       name="PasswordHash"
                       autocomplete="current-password"
                       placeholder="Nhập mật khẩu"
                       required />
            </div>

            <button type="submit" class="login-submit">
                Đăng nhập
            </button>
        }

        <p class="login-register">
            Chưa có tài khoản?
            <a href="@Url.Action("Register", "Account", new { area = "" })">
                Đăng ký
            </a>
        </p>
    </dialog>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script src="@Url.Content("~/Scripts/login-popup.js")"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
