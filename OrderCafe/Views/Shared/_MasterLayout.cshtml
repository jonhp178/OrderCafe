<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/GiaoDien.css" />
</head>
<body>
    <!-- Thanh điều hướng Header -->
    <header class="top">
        <div class="wrap bar">
            <a class="logo" href="@Url.Action("Index", "Home")">HẠT<small>COFFEE</small></a>
            <nav aria-label="Điều hướng chính">
                <a href="@Url.Action("Index", "Home")#trangchu">Trang chủ</a>
                <a href="@Url.Action("Index", "Product")">Menu</a>
                @*<span aria-disabled="true" title="Menu đang được cập nhật">Menu (đang cập nhật)</span>*@
                <span aria-disabled="true" title="Ưu đãi đang được cập nhật">Ưu đãi (đang cập nhật)</span>
                <a href="@Url.Action("Index", "Home")#thongtin">Thông tin</a>
                @*<a href="@Url.Action("Register", "Account")">Đăng Nhập</a>*@
                @if (Session["CustomerId"] != null)
                {
                    string fullName = (Session["CustomerName"] as string ?? "").Trim();
                    string shortName = fullName.Split(' ').LastOrDefault();
                    if (string.IsNullOrEmpty(shortName)) { shortName = "Tài khoản"; }

                    <div class="user-dd">
                        <button type="button" class="user-dd-toggle">@shortName &#9662;</button>
                        <div class="user-dd-menu">
                            @Html.ActionLink("Thông tin cá nhân", "Profile", "Account", new { area = "" }, null)
                            @Html.ActionLink("Đơn của tôi", "History", "Order", new { area = "" }, null)
                            @Html.ActionLink("Giỏ hàng", "Index", "Cart", new { area = "" }, null)
                            @Html.ActionLink("Đổi mật khẩu", "ChangePassword", "Account", new { area = "" }, null)
                            @using (Html.BeginForm("Logout", "Account", new { area = "" }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit">Đăng xuất</button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    @Html.ActionLink("Đăng nhập", "Login", "Account", new { area = "" }, null)
                    @Html.ActionLink("Đăng Ký", "Register", "Account", new { area = "" }, null)
                }
                <a class="hot" href="tel:123456789">Hotline: 123456789</a>
            </nav>
        </div>
    </header>

    <div class="container">
        <div class="row">
            <div class="col-md-3">
                <h3>Danh mục thể loại</h3>
                @Html.Action("MenuTheLoai", "Product")
            </div>
            <div class="col-md-9">
                @RenderBody()
            </div>
        </div>
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year -  HẠT COFFEE</p>
        </footer>
    </div>
    @*@Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)*@
</body>
</html>
