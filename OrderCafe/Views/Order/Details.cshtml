@model OrderCafe.Models.OrderPro
@using System.Globalization
@{
    ViewBag.Title = "Theo dõi đơn hàng";
    Layout = "~/Views/Shared/_GiaoDien.cshtml";
    var waitingForAdmin = Model.Status == "Pending"
        && (Model.PaymentMethod == "COD" || Model.PaymentStatus == "Paid");
}

<link rel="stylesheet" href="~/Content/bootstrap.min.css"/>
<link rel="stylesheet" href="~/Content/GiaoDien.css" />
<h2>Theo dõi đơn hàng @(Model.OrderCode ?? Model.OrderId.ToString())</h2>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["Success"]</div>
}
<div id="order-notification"
     class="alert @(Model.Status == "Confirmed" ? "alert-success" : "alert-info")"
     role="status"
     data-should-poll="@waitingForAdmin.ToString().ToLowerInvariant()"
     data-check-url="@Url.Action("CheckStatus", "Order", new { id = Model.OrderId })">
    @if (Model.Status == "Pending" && Model.PaymentMethod == "VNPAY" && Model.PaymentStatus != "Paid")
    {
        <span>Vui lòng thanh toán VNPay trước khi admin có thể xác nhận đơn.</span>
    }
    else if (Model.Status == "Pending")
    {
        <span>Đơn hàng đang chờ admin xác nhận.</span>
    }
    else if (Model.Status == "Confirmed")
    {
        <strong>Admin đã xác nhận đơn hàng của bạn.</strong>
    }
    else if (Model.Status == "Shipping")
    {
        <span>Đơn hàng đang được chuẩn bị / giao.</span>
    }
    else if (Model.Status == "Completed")
    {
        <span>Đơn hàng đã hoàn thành.</span>
    }
    else if (Model.Status == "Cancelled" && Model.PaymentMethod == "VNPAY" && Model.PaymentStatus == "Paid")
    {
        <span>Đơn đã huỷ nhưng đã thanh toán online. Vui lòng liên hệ cửa hàng để xử lý hoàn tiền.</span>
    }
    else
    {
        <span>Đơn hàng đã bị huỷ.</span>
    }
</div>

<dl class="dl-horizontal">
    <dt>Trạng thái</dt><dd id="order-status">@(Model.Status == "Shipping" ? "Đang chuẩn bị / giao hàng" : Model.Status)</dd>
    <dt>Ngày đặt</dt><dd>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt>Người nhận</dt><dd>@Model.ReceiverName</dd>
    <dt>Điện thoại</dt><dd>@Model.ReceiverPhone</dd>
    <dt>Địa chỉ</dt><dd>@Model.ShippingAddress</dd>
    <dt>Thanh toán</dt><dd>@Model.PaymentMethod / @Model.PaymentStatus</dd>
</dl>

<h3>Món đã đặt</h3>
<table class="table table-bordered">
    <thead><tr><th>Món</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead>
    <tbody>
    @foreach (var item in Model.OrderDetails)
    {
        <tr>
            <td>@item.ProductName</td>
            <td>@item.UnitPrice.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))đ</td>
            <td>@item.Quantity</td>
            <td>@(((decimal)item.UnitPrice * item.Quantity).ToString("N0", CultureInfo.GetCultureInfo("vi-VN")))đ</td>
        </tr>
    }
    </tbody>
    <tfoot><tr><th colspan="3">Tổng cộng</th><th>@Model.TotalAmount.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))đ</th></tr></tfoot>
</table>

<p>
    @Html.ActionLink("Đơn hàng của tôi", "Index", null, new { @class = "btn btn-default" })
    @Html.ActionLink("Tiếp tục mua hàng", "Index", "Product", null, new { @class = "btn btn-default" })
    @if (Model.Status == "Pending" && Model.PaymentMethod == "VNPAY" && Model.PaymentStatus != "Paid")
    {
        using (Html.BeginForm("Pay", "Payment", new { id = Model.OrderId }, FormMethod.Post, new { style = "display:inline" }))
        {
            @Html.AntiForgeryToken()
            @*<button type="submit" class="btn btn-primary">Thanh toán / thử lại VNPay Sandbox</button>*@
            <button type="submit" class="btn btn-primary">Thanh toán</button>
        }
    }
</p>

@section scripts {
    <script src="~/Scripts/order-details.js"></script>
}
